<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.1.0.0</Version>
    <Author>yurammaruy</Author>
    <Name>Navi Fantasy</Name>
    <InternalName>NaviFantasy</InternalName>
    <Punchline>A fairy companion that flutters around your character and yells for your attention.</Punchline>
    <Description>Navi Fantasy puts a flapping fairy next to your character and plays a sound every 30 seconds. Use /navi to change her size.</Description>
    <RepoUrl>https://github.com/yurammaruy/NaviFantasy</RepoUrl>
    <Tags>fairy;companion;navi;fun</Tags>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Floating versions so the first restore works; pin them (and commit packages.lock.json) before submitting anywhere official. -->
    <PackageReference Include="NAudio" Version="2.*" />
    <PackageReference Include="NLayer.NAudioSupport" Version="1.*" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
